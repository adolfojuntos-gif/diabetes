# Copy to .env.local

NEXT_PUBLIC_APP_NAME="Steady"
NEXT_PUBLIC_APP_TAGLINE="Your diabetes, one day at a time."

# Local SQLite by default. Point at Turso (libsql) for hosted.
DATABASE_URL=file:./data/steady.db
# DATABASE_AUTH_TOKEN=

# AI journal companion. Without a key the journal still works: it shows the
# engine's own pattern summary, labelled as such. Nothing is faked.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5

# Scheduled check-ins are authenticated per account, not with one shared secret. Each account
# gets its own bearer token from Settings, and POST /api/coach/morning with
# "Authorization: Bearer <that token>" writes that account's brief and nobody else's.

# Accounts and sessions live in their own database, separate from every account's clinical data.
CONTROL_DATABASE_URL=file:./data/control.db
# CONTROL_DATABASE_AUTH_TOKEN=

# Each account's clinical data lives in its own database. Local files by default; set the Turso
# organisation host to put them on Turso instead.
# TURSO_ORG_HOST=your-org.turso.io
# ACCOUNT_DATABASE_AUTH_TOKEN=

# How long a session cookie lasts. Clamped to between 1 and 365.
SESSION_DAYS=30
# COOKIE_SECURE=false   # only for an http:// deployment on a private network
# COACH_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# BILLING (optional). With none of these set, the app runs, the billing screen
# says billing is not available, and nobody's plan changes. That is the safe
# default: an app that opens its paid features when billing is misconfigured is
# worse than one that refuses, because the failure is invisible.
#
# Get these from your own Stripe dashboard. Use the TEST keys (sk_test_...)
# until you have run a real checkout through and watched the plan change.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# The signing secret for THIS endpoint, from Stripe's webhook settings or from
# `stripe listen`. It is not the API key, and the webhook refuses everything
# without it.
# STRIPE_WEBHOOK_SECRET=whsec_...
# The recurring price the upgrade button buys. Create a $20/month product first.
# STRIPE_PRICE_ID=price_...
# How the price is written to a person. Display only; Stripe holds the real one.
# STRIPE_PRICE_DISPLAY=$20 a month
#
# Where Stripe sends people back to after checkout. Absolute, and deliberately
# NOT derived from the request's Host header, which a caller controls: a success
# URL built from a header is an open redirect on the end of a payment flow.
# APP_URL=https://your-app.fly.dev
#
# How many account databases may be open at once. One SQLite connection each,
# evicted least-recently-used. Raise it only with the file descriptor limit.
# MAX_OPEN_ACCOUNT_DBS=256
