      "id": "c5214f50-89c1-44c7-bc02-cfed0afee210",
      "name": "Check Saved Card",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -80
      ],
      "credentials": {
        "httpHeaderAuth": {
