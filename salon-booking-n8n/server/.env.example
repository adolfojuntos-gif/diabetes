# Copy this file to .env and fill it in. Never share .env or commit it.

# The web address for n8n. Point this name's DNS "A record" at your server's IP first.
N8N_DOMAIN=n8n.yourdomain.com

# Salon time zone
TIMEZONE=America/Chicago

# A long random password that protects your saved credentials.
# Make one with:  openssl rand -hex 32
# Keep a copy somewhere safe: without it, saved credentials can't be read after a restore.
N8N_ENCRYPTION_KEY=
